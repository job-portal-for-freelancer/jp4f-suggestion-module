name: "jina"
backend: "onnxruntime"
max_batch_size: 0

input [
  {
    name: "attention_mask"
    data_type: TYPE_INT64
    dims: [-1, -1] 
  },
  {
    name: "task_id"
    data_type: TYPE_INT64
    dims: [1]  
  },
  {
    name: "input_ids"
    data_type: TYPE_INT64
    dims: [-1, -1] 
  }
]

output [
  {
    name: "text_embeds"
    data_type: TYPE_FP32
    dims: [-1, -1, 1024] 
  },
  {
    name: "13049"
    data_type: TYPE_FP32
    dims: [-1, 1024] 
  }
]

instance_group [
  {
    kind: KIND_CPU
  }
]
